{
  "info": {
    "name": "GigFlow API",
    "description": "Production-style Postman collection for GigFlow authentication, RBAC, lead management, filtering, pagination, CSV export, and validation/error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testRunId')) {",
          "  const id = Date.now().toString();",
          "  pm.collectionVariables.set('testRunId', id);",
          "  pm.collectionVariables.set('adminEmail', `admin.${id}@gigflow.test`);",
          "  pm.collectionVariables.set('salesEmail', `sales.${id}@gigflow.test`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "salesToken", "value": "" },
    { "key": "leadId", "value": "" },
    { "key": "testRunId", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "salesEmail", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GigFlow Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"AdminPass123\",\n  \"role\": \"Admin\"\n}"
            },
            "url": {
                      "raw": "{{baseUrl}}/api/auth/register",
                      "host": ["{{baseUrl}}"],
                      "path": ["api", "auth", "register"]
                    }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('success flag is true', () => pm.expect(json.success).to.eql(true));",
              "pm.test('returns admin user and token', () => {",
              "  pm.expect(json.data.user.role).to.eql('Admin');",
              "  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get('adminEmail'));",
              "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
              "});"
            ] }
          }]
        },
        {
          "name": "Register Sales",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GigFlow Sales\",\n  \"email\": \"{{salesEmail}}\",\n  \"password\": \"SalesPass123\",\n  \"role\": \"Sales\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('success flag is true', () => pm.expect(json.success).to.eql(true));",
              "pm.test('returns sales user and token', () => {",
              "  pm.expect(json.data.user.role).to.eql('Sales');",
              "  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get('salesEmail'));",
              "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
              "});"
            ] }
          }]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"AdminPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('login succeeds', () => pm.expect(json.success).to.eql(true));",
              "pm.test('admin token exists and is saved', () => {",
              "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('adminToken', json.data.token);",
              "});",
              "pm.test('admin role returned', () => pm.expect(json.data.user.role).to.eql('Admin'));"
            ] }
          }]
        },
        {
          "name": "Login Sales",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{salesEmail}}\",\n  \"password\": \"SalesPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('login succeeds', () => pm.expect(json.success).to.eql(true));",
              "pm.test('sales token exists and is saved', () => {",
              "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('salesToken', json.data.token);",
              "});",
              "pm.test('sales role returned', () => pm.expect(json.data.user.role).to.eql('Sales'));"
            ] }
          }]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('current user is returned', () => {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get('adminEmail'));",
              "  pm.expect(json.data.user.role).to.eql('Admin');",
              "});"
            ] }
          }]
        }
      ]
    },
    {
      "name": "Leads CRUD",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.{{testRunId}}@example.com\",\n  \"status\": \"New\",\n  \"source\": \"Instagram\"\n}"
            },
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('lead is created', () => {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.lead.id).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.lead.status).to.eql('New');",
              "  pm.expect(json.data.lead.source).to.eql('Instagram');",
              "});",
              "pm.collectionVariables.set('leadId', json.data.lead.id);"
            ] }
          }]
        },
        {
          "name": "Get All Leads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('returns lead list and pagination', () => {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.leads).to.be.an('array');",
              "  pm.expect(json.pagination.page).to.eql(1);",
              "  pm.expect(json.pagination.limit).to.eql(10);",
              "  pm.expect(json.pagination.total).to.be.a('number');",
              "});"
            ] }
          }]
        },
        {
          "name": "Get Single Lead",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('returns requested lead', () => {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.lead.id).to.eql(pm.collectionVariables.get('leadId'));",
              "});"
            ] }
          }]
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Qualified\",\n  \"source\": \"Referral\"\n}"
            },
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('lead is updated', () => {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.lead.id).to.eql(pm.collectionVariables.get('leadId'));",
              "  pm.expect(json.data.lead.status).to.eql('Qualified');",
              "  pm.expect(json.data.lead.source).to.eql('Referral');",
              "});"
            ] }
          }]
        },
        {
          "name": "Delete Lead",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const json = pm.response.json();",
              "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('delete succeeds', () => {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.message).to.match(/deleted/i);",
              "});"
            ] }
          }]
        }
      ]
    },
    {
      "name": "Filtering & Search",
      "item": [
        {
          "name": "Filter by status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?status=Qualified"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('all returned leads match status', () => json.data.leads.forEach((lead) => pm.expect(lead.status).to.eql('Qualified')));"
          ] } }]
        },
        {
          "name": "Filter by source",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?source=Instagram"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('all returned leads match source', () => json.data.leads.forEach((lead) => pm.expect(lead.source).to.eql('Instagram')));"
          ] } }]
        },
        {
          "name": "Search by name",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?search=rahul"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('search matches name or email', () => json.data.leads.forEach((lead) => pm.expect(`${lead.name} ${lead.email}`.toLowerCase()).to.include('rahul')));"
          ] } }]
        },
        {
          "name": "Search by email",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?search=example.com"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('search matches email domain when results exist', () => json.data.leads.forEach((lead) => pm.expect(`${lead.name} ${lead.email}`.toLowerCase()).to.include('example.com')));"
          ] } }]
        },
        {
          "name": "Combined filters",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?status=Qualified&source=Referral&search=rahul&sort=latest"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('combined filters are respected', () => json.data.leads.forEach((lead) => {",
            "  pm.expect(lead.status).to.eql('Qualified');",
            "  pm.expect(lead.source).to.eql('Referral');",
            "  pm.expect(`${lead.name} ${lead.email}`.toLowerCase()).to.include('rahul');",
            "}));"
          ] } }]
        }
      ]
    },
    {
      "name": "Pagination",
      "item": [
        {
          "name": "Page 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?page=1&sort=latest"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns page 1 metadata', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(json.pagination.page).to.eql(1);",
            "  pm.expect(json.pagination.limit).to.eql(10);",
            "  pm.expect(json.pagination.pages).to.be.a('number');",
            "  pm.expect(json.data.leads.length).to.be.at.most(10);",
            "});"
          ] } }]
        },
        {
          "name": "Page 2",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads?page=2&sort=oldest"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns page 2 metadata', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(json.pagination.page).to.eql(2);",
            "  pm.expect(json.pagination.limit).to.eql(10);",
            "  pm.expect(json.data.leads.length).to.be.at.most(10);",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "RBAC",
      "item": [
        {
          "name": "Sales trying to delete lead",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": "{{baseUrl}}/api/leads/{{leadId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 403 Forbidden', () => pm.response.to.have.status(403));",
            "pm.test('error response is clean', () => {",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.message).to.eql('Forbidden');",
            "});"
          ] } }]
        },
        {
          "name": "Sales trying to export CSV",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": "{{baseUrl}}/api/leads/export/csv"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 403 Forbidden', () => pm.response.to.have.status(403));",
            "pm.test('sales cannot export', () => {",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.message).to.eql('Forbidden');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "CSV Export",
      "item": [
        {
          "name": "Admin export CSV",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/leads/export/csv"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('content type is CSV', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
            "pm.test('CSV contains expected headers', () => {",
            "  const body = pm.response.text();",
            "  pm.expect(body).to.include('\"ID\",\"Name\",\"Email\",\"Status\",\"Source\",\"Created At\",\"Updated At\"');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "Validation & Error Cases",
      "item": [
        {
          "name": "Invalid email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Email Lead\",\n  \"email\": \"not-an-email\",\n  \"status\": \"New\",\n  \"source\": \"Website\"\n}"
            },
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('validation error format', () => {",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.message).to.be.a('string').and.not.empty;",
            "});"
          ] } }]
        },
        {
          "name": "Invalid status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Status Lead\",\n  \"email\": \"invalid.status.{{testRunId}}@example.com\",\n  \"status\": \"Won\",\n  \"source\": \"Website\"\n}"
            },
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('invalid enum is rejected', () => pm.expect(json.success).to.eql(false));"
          ] } }]
        },
        {
          "name": "Missing required fields",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"missing.name.{{testRunId}}@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('required field validation fails', () => {",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.message).to.be.a('string').and.not.empty;",
            "});"
          ] } }]
        },
        {
          "name": "Missing token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 401 Unauthorized', () => pm.response.to.have.status(401));",
            "pm.test('unauthorized error format', () => {",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.message).to.eql('Unauthorized');",
            "});"
          ] } }]
        },
        {
          "name": "Invalid token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.jwt.token" }],
            "url": "{{baseUrl}}/api/leads"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const json = pm.response.json();",
            "pm.test('returns 401 Unauthorized', () => pm.response.to.have.status(401));",
            "pm.test('invalid token is rejected', () => {",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.message).to.eql('Unauthorized');",
            "});"
          ] } }]
        }
      ]
    }
  ]
}
